{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // The connection string does NOT live here.
  // Development: dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
  // Production: environment variable ConnectionStrings__DefaultConnection

  "WhatsApp": {
    "CountryCode": "356"
  },

  // Origins the SPA is served from. Empty by default: each installation declares its own.
  "Cors": {
    "AllowedOrigins": []
  },

  // The first Proprietor account, created only when no user exists yet.
  // Set both values through user-secrets or environment variables, never here.
  //   Bootstrap__Proprietor__Email / Bootstrap__Proprietor__Password
  "Bootstrap": {
    "Proprietor": {
      "DisplayName": "Proprietor"
    }
  },

  "AllowedHosts": "*"
}
